# Copiez ce fichier en .env et remplissez les valeurs
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=verify-full"
BETTER_AUTH_SECRET="une-longue-chaine-aleatoire"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_EMAILS="votre-email@exemple.com"

# Paiement des abonnements par Wave / Orange Money (https://app.saspay.me > Développeur)
# Clé de test : sk_test_... ; clé réelle : sk_live_...
SASPAY_API_KEY=""
# Secret de signature des notifications (SasPay > Webhooks), facultatif
SASPAY_WEBHOOK_SECRET=""

# Assistant vocal — clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Facultatif : modèle(s) à essayer en premier, séparés par des virgules ; les modèles de secours du code restent derrière
GEMINI_MODEL=
# Voix Anta (wolof) : la voix publique https://ndaosaer-wolof-tts.hf.space pour les essais, ou votre copie (Hugging Face PRO)
ANTA_TTS_URL=
# Demandes à l'assistant par commerce et par jour
ASSISTANT_DAILY_LIMIT=60
